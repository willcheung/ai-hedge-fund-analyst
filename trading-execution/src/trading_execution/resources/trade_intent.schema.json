{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TradeIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_id",
    "created_at",
    "mode",
    "broker",
    "symbol",
    "side",
    "contracts",
    "entry_type",
    "stop_price",
    "max_loss_usd",
    "thesis",
    "expires_at",
    "requires_human_approval"
  ],
  "properties": {
    "intent_id": {"type": "string", "pattern": "^TI-[0-9]{8}-[a-z0-9]{6}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["paper", "live"]},
    "broker": {"enum": ["ibkr"]},
    "symbol": {"type": "string"},
    "side": {"enum": ["BUY", "SELL"]},
    "contracts": {"type": "integer", "minimum": 1},
    "entry_type": {"enum": ["LIMIT", "STOP_LIMIT"]},
    "limit_price": {"type": ["number", "null"]},
    "stop_price": {"type": "number"},
    "target_price": {"type": ["number", "null"]},
    "max_loss_usd": {"type": "number", "exclusiveMinimum": 0},
    "thesis": {"type": "string", "minLength": 1},
    "invalidation": {"type": ["string", "null"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "requires_human_approval": {"const": true},
    "human_approval": {
      "type": ["object", "null"],
      "properties": {
        "approved": {"type": "boolean"},
        "reviewer": {"type": "string"},
        "decided_at": {"type": "string"}
      },
      "required": ["approved", "reviewer", "decided_at"],
      "additionalProperties": false
    },
    "blocked_event_override": {"type": "boolean"}
  }
}
